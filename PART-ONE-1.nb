Notebook[{
Cell[BoxData[
 RowBox[{"Quit", "[", "]"}]], "Input",
 CellChangeTimes->{{4.0040107364961815`*^9, 4.004010739355831*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"3d412707-5cda-c64e-bc28-c45eb678f01f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"STEP", " ", "1"}], ":", 
    RowBox[{"Load", " ", "FeynCalc", " ", "with", " ", "FeynArts"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"$LoadAddOns", "=", 
     RowBox[{"{", "\"\<FeynArts\>\"", "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<FeynCalc`\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"$FAVerbose", "=", "0"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<======================================\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<STEP 1: PACKAGE INITIALIZATION\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<======================================\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<FeynCalc version: \>\"", ",", "$FeynCalcVersion"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<FeynArts directory: \>\"", ",", "$FeynArtsDirectory"}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"STEP", " ", "2"}], ":", 
     RowBox[{"Define", " ", "Phi4", " ", "model", " ", "directory"}]}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<STEP 2: MODEL DIRECTORY\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"faModelsDir", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"$FeynArtsDirectory", ",", "\"\<Models\>\""}], "}"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"phi4Dir", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"faModelsDir", ",", "\"\<Phi4\>\""}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"phi4Name", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<Phi4\>\"", ",", "\"\<Phi4\>\""}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Phi4 directory: \>\"", ",", "phi4Dir"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"STEP", " ", "3"}], ":", 
     RowBox[{"Verify", " ", "required", " ", "model", " ", "files"}]}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<STEP 3: VERIFY MODEL FILES\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"requiredFiles", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<Phi4.mod\>\"", ",", "\"\<Phi4.gen\>\"", 
       ",", "\"\<Phi4.pars\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"fileChecks", "=", 
     RowBox[{"Association", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"file", "->", 
         RowBox[{"FileExistsQ", "[", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"phi4Dir", ",", "file"}], "}"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"file", ",", "requiredFiles"}], "}"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"KeyValueMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Print", "[", 
         RowBox[{"#1", ",", "\"\<: \>\"", ",", "#2"}], "]"}], ")"}], "&"}], ",",
       "fileChecks"}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"And", "@@", 
        RowBox[{"Values", "[", "fileChecks", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", "\"\<ERROR: One or more model files are missing.\>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<All required model files found.\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"STEP", " ", "4"}], ":", 
     RowBox[{
      RowBox[{"Check", " ", "the", " ", "previous", " ", "line"}], "-", 
      RowBox[{"84", " ", "error"}]}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<STEP 4: CHECK GENERIC MODEL SYNTAX\>\"", "]"}],
     ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"genFile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"phi4Dir", ",", "\"\<Phi4.gen\>\""}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"genText", "=", 
     RowBox[{"Import", "[", 
      RowBox[{"genFile", ",", "\"\<Text\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"StringQ", "[", "genText", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<ERROR: Cannot read Phi4.gen.\>\"", "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"malformedIndexSum", "=", 
     RowBox[{"StringContainsQ", "[", 
      RowBox[{"genText", ",", 
       RowBox[{
       "RegularExpression", "[", "\"\<IndexSum\\\\s*\\\\[\\\\s*,\>\"", 
        "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Malformed IndexSum detected: \>\"", ",", 
      "malformedIndexSum"}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{"malformedIndexSum", ",", 
      RowBox[{
       RowBox[{
       "Print", "[", "\"\<ERROR: Old line-84 syntax issue detected.\>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", "\"\<Restore the corrected Phi4 model files.\>\"", "]"}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Known syntax problem not detected.\>\"", "]"}],
     ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"STEP", " ", "5"}], ":", 
     RowBox[{"Verify", " ", "FeynArts", " ", "functions"}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<STEP 5: VERIFY FEYNARTS FUNCTIONS\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"functionNames", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<CreateTopologies\>\"", ",", "\"\<InsertFields\>\"", 
       ",", "\"\<Paint\>\"", ",", "\"\<CreateFeynAmp\>\"", 
       ",", "\"\<InitializeModel\>\""}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"functionMatches", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Names", "[", 
        RowBox[{"\"\<*`\>\"", "<>", "name"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"name", ",", "functionNames"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"functionNames", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", "\"\<: \>\"", ",", 
        RowBox[{"functionMatches", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "functionNames", "]"}]}], "}"}]}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"AnyTrue", "[", 
       RowBox[{"functionMatches", ",", 
        RowBox[{
         RowBox[{"#", "===", 
          RowBox[{"{", "}"}]}], "&"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", "\"\<ERROR: Some FeynArts functions are missing.\>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<FeynArts functions found.\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"STEP", " ", "6"}], ":", 
     RowBox[{"Check", " ", "model", " ", "search", " ", "path"}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<STEP 6: CONFIGURE MODEL SEARCH PATH\>\"", "]"}], ";"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"MemberQ", "[", 
        RowBox[{"$ModelPath", ",", "faModelsDir"}], "]"}]}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"$ModelPath", ",", "faModelsDir"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Phi4 model name: \>\"", ",", "phi4Name"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Model file exists: \>\"", ",", 
      RowBox[{"FileExistsQ", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"phi4Dir", ",", "\"\<Phi4.mod\>\""}], "}"}], "]"}], "]"}]}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"STEP", " ", "7"}], ":", 
     RowBox[{"Initialize", " ", "Phi4"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<STEP 7: INITIALIZE PHI4 MODEL\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"modelResult", "=", 
     RowBox[{"InitializeModel", "[", 
      RowBox[{"phi4Name", ",", 
       RowBox[{"GenericModel", "->", "phi4Name"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Initialization result: \>\"", ",", "modelResult"}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"modelResult", "=!=", "True"}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", "\"\<ERROR: Phi4 model initialization failed.\>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"STEP", " ", "8"}], ":", 
     RowBox[{"Final", " ", "confirmation"}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<======================================\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<PHI4 ENVIRONMENT READY\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<======================================\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<FeynCalc: Loaded\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<FeynArts: Loaded\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Phi4 files: Found\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Known line-84 error: Not detected\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Model initialization: Successful\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<You may now generate Feynman diagrams.\>\"", "]"}], 
    ";"}], "\n"}]}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"689f7cc4-1d04-5942-9218-91d5036d6fe7"],

