Cell[BoxData[
 FormBox[
  InterpretationBox[
   RowBox[{
    StyleBox["\<\"General convolution coefficient C(a,b):\"\>",
     StripOnInput->False,
     FontSize->12,
     FontWeight->Bold], "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
    TagBox[
     FormBox[
      FractionBox[
       RowBox[{
        SuperscriptBox["2", 
         RowBox[{"eps", "-", "4"}]], " ", 
        SuperscriptBox["\[Pi]", 
         FractionBox[
          RowBox[{"eps", "-", "4"}], "2"]], " ", 
        TemplateBox[{
          RowBox[{
            FractionBox[
             RowBox[{"4", "-", "eps"}], "2"], "-", "a"}]},
         "Gamma"], " ", 
        TemplateBox[{
          RowBox[{
            FractionBox[
             RowBox[{"4", "-", "eps"}], "2"], "-", "b"}]},
         "Gamma"], " ", 
        TemplateBox[{
          RowBox[{"a", "+", "b", "+", 
            FractionBox[
             RowBox[{"eps", "-", "4"}], "2"]}]},
         "Gamma"]}], 
       RowBox[{
        TemplateBox[{"a"},
         "Gamma"], " ", 
        TemplateBox[{"b"},
         "Gamma"], " ", 
        TemplateBox[{
          RowBox[{
            RowBox[{"-", "a"}], "-", "b", "-", "eps", "+", "4"}]},
         "Gamma"]}]],
      TraditionalForm],
     TraditionalForm,
     Editable->True], "\[InvisibleSpace]", "\<\"   [\"\>", 
    "\[InvisibleSpace]", "\<\"Derived using QFT I, Eqs. (13.7), (13.20), \
pp.114, 121\"\>", "\[InvisibleSpace]", "\<\"]\"\>"}],
   SequenceForm[
    Style["General convolution coefficient C(a,b):", 12, Bold], " ", 
    TraditionalForm[
    2^(-4 + $CellContext`eps) Pi^(Rational[1, 2] (-4 + $CellContext`eps)) 
     Gamma[$CellContext`a]^(-1) Gamma[$CellContext`b]^(-1) 
     Gamma[-$CellContext`a + Rational[1, 2] (4 - $CellContext`eps)] 
     Gamma[-$CellContext`b + Rational[1, 2] (4 - $CellContext`eps)] 
     Gamma[$CellContext`a + $CellContext`b + 
       Rational[1, 2] (-4 + $CellContext`eps)]/Gamma[
     4 - $CellContext`a - $CellContext`b - $CellContext`eps]], "   [", 
    "Derived using QFT I, Eqs. (13.7), (13.20), pp.114, 121", "]"],
   Editable->False], TraditionalForm]], "Print",
 CellChangeTimes->{4.004197021687639*^9},
 CellLabel->
