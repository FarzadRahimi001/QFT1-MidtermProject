  InterpretationBox[
   RowBox[{
    StyleBox["\<\"Finite eps^0 coefficient:\"\>",
     StripOnInput->False,
     FontSize->12,
     FontWeight->Bold], "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
    TagBox[
     FormBox[
      FractionBox[
       RowBox[{"p2", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "8"}], " ", 
           RowBox[{"log", "(", "mu", ")"}]}], "+", 
          RowBox[{"4", " ", 
           RowBox[{"log", "(", "p2", ")"}]}], "-", 
          RowBox[{"4", " ", 
           RowBox[{"log", "(", 
            RowBox[{"4", " ", "\[Pi]"}], ")"}]}], "+", 
          RowBox[{"4", " ", 
           TagBox["\[DoubledGamma]",
            Function[{}, EulerGamma]]}], "-", "13"}], ")"}]}], 
       RowBox[{"2048", " ", 
        SuperscriptBox["\[Pi]", "4"]}]],
      TraditionalForm],
     TraditionalForm,
     Editable->True], "\[InvisibleSpace]", "\<\"   [\"\>", 
    "\[InvisibleSpace]", "\<\"Derived here; cf. QFT I, Eq. (15.16), p.155 \
