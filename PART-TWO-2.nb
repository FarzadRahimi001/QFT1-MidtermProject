            RowBox[{"(", 
             RowBox[{"4", " ", "Pi"}], ")"}], "^", "4"}]}], ")"}]}], "]"}], 
       "]"}], ",", "\"\< + O(lam^3)\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
