           RowBox[{
            RowBox[{
             RowBox[{"hFromM", "/", "cH"}], "==", "waterLaw"}], ",", 
            RowBox[{"Assumptions", "->", "ass"}]}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Critical pressure deviation vanishes\>\"", ",", 
         RowBox[{"TrueQ", "[", 
          RowBox[{"FullSimplify", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"waterLaw", "/.", " ", 
               RowBox[{"rho", "->", "rhoC"}]}], ")"}], "==", "0"}], ",", 
            RowBox[{"Assumptions", "->", "ass"}]}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Correct sign across critical density\>\"", ",", 
         RowBox[{"TrueQ", "[", 
          RowBox[{"FullSimplify", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"waterLaw", "/.", " ", 
                RowBox[{"rho", "->", 
                 RowBox[{"rhoC", "*", 
                  RowBox[{"(", 
                   RowBox[{"1", "+", "t"}], ")"}]}]}]}], ")"}], "+", 
              RowBox[{"(", 
               RowBox[{"waterLaw", "/.", " ", 
                RowBox[{"rho", "->", 
                 RowBox[{"rhoC", "*", 
                  RowBox[{"(", 
                   RowBox[{"1", "-", "t"}], ")"}]}]}]}], ")"}]}], "==", "0"}],
             ",", 
            RowBox[{"Assumptions", "->", "ass"}]}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Logarithmic slope equals delta\>\"", ",", 
         RowBox[{"TrueQ", "[", 
          RowBox[{"FullSimplify", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"t", "*", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"Log", "[", 
                 RowBox[{"A", "*", 
                  RowBox[{"t", "^", "delta"}]}], "]"}], ",", "t"}], "]"}]}], "==",
              "delta"}], ",", 
            RowBox[{"Assumptions", "->", "ass"}]}], "]"}], "]"}]}], "}"}]}], 
      "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
