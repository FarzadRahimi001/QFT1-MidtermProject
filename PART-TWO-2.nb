   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"print223", "[", 
     RowBox[{"\"\<The pole in Z_phi cancels the \>\"", 
      ",", "\"\<canonical -eps*g factor in beta_g.\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"print223", "[", "\"\<Final anomalous dimension:\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
